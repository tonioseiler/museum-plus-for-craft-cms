{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("furbo\\museumplusforcraftcms\\assetbundles\\museumplusforcraftcms\\MuseumPlusForCraftCmsAsset") %}
{% do view.registerAssetBundle("furbo\\museumplusforcraftcms\\assetbundles\\collectioncpsection\\CollectionCPSectionAsset") %}

{% macro printArray(arr) %}
    {% for k,v in arr %}
        <li>
        {% if v is iterable %}
            {% if k matches '/^\\d+$/' %}
                {# ?? #}
            {% else %}
                <li style="font-style: italic;">{{ k }}:</li>
            {% endif %}
            <ul style="padding-left: 1rem; margin-bottom: 0.6rem;">
                {{ _self.printArray(v) }}
            </ul>
        {% else %}
            <span style="font-style: italic;">{{ k }}</span>: {{ v }}
            <br/>
        {% endif %}
        </li>
    {% endfor %}
{% endmacro %}

{# The title of this CP section #}
{% set title = person.title %}
{% set selectedSubnavItem = 'people' %}

{% if craft.app.getIsMultiSite() %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: requestedSite.name|t('site'),
        menu: {
            items: siteMenuItems(null, requestedSite),
            label: 'Select site'|t('app')
        },
    }] %}
{% endif %}

{% set fieldLayout = person.getFieldLayout() %}
{% set form = fieldLayout.createForm(person) %}
{% set firstTabs = {
    "tab--museumplusforcraftcms-person": {
        "tabId": "tab-tab--museumplusforcraftcms-person",
        "label": "Person",
        "url": "#tab--museumplusforcraftcms-person",
        "class": null
    },
    "tab--museumplusforcraftcms-data": {
        "tabId": "tab-tab--museumplusforcraftcms-data",
        "label": "Data",
        "url": "#tab--museumplusforcraftcms-data",
        "class": null
    },
}
%}

{% set tabs = firstTabs|merge(form.getTabMenu()) %}
{% set fieldsHtml = form.render(false) %}

{% block actionButton %}

    <div class="btngroup">
        <a class="view-btn btn" href="{{ person.url }}" target="_blank">
            {{ "View"|t }}
        </a>
        <button type="button" class="btn formsubmit" data-action="museum-plus-for-craft-cms/people/sync">{{ 'Sync'|t('app') }}</button>

        <input type="submit" class="btn submit" value="{{ 'Save'|t }}">
    </div>

{% endblock %}


{% block header %}

    <div class="flex flex-nowrap">
        {{ block('pageTitle') }}
    </div>
    <div class="flex">
        {{ block('actionButton') }}
    </div>

{% endblock %}


{% block content %}

    {{ actionInput('museum-plus-for-craft-cms/people/update') }}
    {{ redirectInput( person.getCpEditUrl() ) }}
    <input type="hidden" name="personId" value="{{ person.id }}" />

        <div id="tab--museumplusforcraftcms-person" class="flex-fields" data-id="tab--museumplusforcraftcms-person" role="tabpanel" aria-labelledby="tab-tab--museumplusforcraftcms-multimedia">
            <fieldset id="fields-item-data" class="field">
                <div class="field" data-attribute="title">
                    <div class="heading">
                        <label id="fields-title-label" for="fields-title">{{ 'Title'|t('museum-plus-for-craft-cms') }}</label>
                        <div class="flex-grow"></div>
                    </div>
                    <div class="input ltr">
                        {{ person.title }}
                    </div>
                </div>
            </fieldset>

            <fieldset id="fields-item-refs" class="field">
                <div class="field" data-attribute="attachment">
                    <h2>Digital Assets</h2>
                    <div class="input ltr">
                        {% for myAsset in person.getAssets() %}
                            {% if myAsset %}
                                {% if myAsset.kind == 'image' %}
                                    {% set thumb = {
                                        width: 300,
                                        quality: 75
                                    } %}
                                    {% set myAssetUrl = myAsset.getUrl(thumb) %}

                                    <a href="{{ myAsset.getCpEditUrl() }}">
                                        <img src="{{ myAssetUrl }}" width="150"/>
                                    </a>
                                {% else %}
                                    <p>
                                        <a href="{{ myAsset.getCpEditUrl() }}">
                                            {{ myAsset.filename }}
                                        </a>
                                    </p>
                                {% endif %}
                                {% else %}
                                    <p>No asset selected</p>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </fieldset>

            <fieldset id="fields-item-refs" class="field">
                <div class="field" data-attribute="attachment">
                    {% set items = person.getItems() %}
                    <h2>Collection ({{ items|length }} items)</h2>
                    <div class="input ltr">

                        <table  class="display nowrap data fullwidth collapsible">
                            <thead>
                            <tr><th scope="col">Title</th>
                                <th scope="col">Inventory Number</th>
                            </tr></thead>
                            <tbody>
                            {% for item in items %}
                                <tr>
                                    <th scope="row" data-title="Email">
                                        <a href="{{ item.getCpEditUrl() }}">{{ item.title }}</a>
                                    </th>
                                    <td>
                                        {{ item.inventoryNumber }}
                                    </td>
                                </tr>
                            {% endfor %}

                            </tbody>
                        </table>

                    </div>
                </div>
            </fieldset>

            <fieldset id="fields-item-refs" class="field">
                <div class="field" data-attribute="attachment">
                    {% set ownerships = person.getOwnerships() %}
                    <h2>Ownerships ({{ ownerships|length }})</h2>
                    <div class="input ltr">

                        <table  class="display nowrap data fullwidth collapsible">
                            <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Title</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for ownership in ownerships %}
                                <tr>
                                    <td>
                                        {{ ownership.id }}
                                    </td>
                                    <td scope="row">
                                        {{ ownership.title }}
                                    </td>
                                </tr>
                            {% endfor %}

                            </tbody>
                        </table>

                    </div>
                </div>
            </fieldset>

        </div>

        <div id="tab--museumplusforcraftcms-data" class="flex-fields hidden" data-id="tab--museumplusforcraftcms-data" role="tabpanel" aria-labelledby="tab-tab--museumplusforcraftcms-data">



            {% for key,value in person.getDataAttributes() %}

                <div id="fields-{{ key }}-field" class="field width-100">
                    <div class="heading">
                        <label id="fields-{{ key }}-label" for="fields-{{ key }}">{{ key|t('museum-plus-for-craft-cms') }}</label>
                        <div class="flex-grow"></div>
                        <div id="fields-{{ key }}-attribute" class="code small light copytextbtn" role="button" tabindex="0">
                            <input type="text" value="{{ key }}" readonly="" size="17" tabindex="-1">
                        </div>
                    </div>
                    <div class="input ltr">

                        {% if value is iterable %}
                            <ul>
                                {{ _self.printArray(value) }}
                            </ul>
                            <hr/>
                        {% else %}
                            {% set v = value is iterable ? value|join(',') : value.timestamp is defined ? value|date : value %}
                            {% if v|length < 60 %}
                                <input type="text" id="fields-{{ key }}" disabled="disabled" class="disabled nicetext text fullwidth" name="fields[{{ key }}]" autocomplete="off" placeholder="" dir="ltr" data-show-chars-left="" value="{{ v }}">
                            {% else %}
                                <textarea id="fields-{{ key }}" disabled="disabled" class="nicetext text fullwidth disabled" name="fields[{{ key }}]" rows="4" cols="50" placeholder="" data-show-chars-left="" style="min-height: 94px;">{{ v|nl2br }}</textarea>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>


    {{ fieldsHtml|raw }}

{% endblock %}
