{% extends 'museum-plus-for-craft-cms/_settings/layout' %}

{% import '_includes/forms' as forms %}

{% set title = craft.museumPlus.cpTitle~' - Settings' %}

{% set crumbs = [] %}

{% set fullPageForm = true %}

{% block content %}

    <input type="hidden" name="action" value="museum-plus-for-craft-cms/settings/save">
    {{ forms.textField({
        label: 'Classifier',
        instructions: '',
        id: 'classifier',
        name: 'classifier',
        value: settings['classifier']})
    }}

    {{ forms.textField({
        label: 'Hostname',
        instructions: '',
        id: 'hostname',
        name: 'hostname',
        value: settings['hostname']})
    }}

    {{ forms.textField({
        label: 'Username',
        instructions: '',
        id: 'username',
        name: 'username',
        value: settings['username']})
    }}

    {{ forms.textField({
        label: 'Password',
        instructions: '',
        id: 'password',
        name: 'password',
        type: 'password',
        value: settings['password']})
    }}

    {{ forms.textField({
        label: 'Language Header',
        instructions: 'Language of the formatted values in the object data (sent as `Accept-Language` to MuseumPlus). One language code, e.g. "de" or "en".',
        id: 'languageHeader',
        name: 'languageHeader',
        value: settings['languageHeader'],
        errors: settings.getErrors('languageHeader')})
    }}

    {{ forms.textField({
        label: 'Vocabulary Languages',
        instructions: 'Languages of the vocabulary terms to import, comma separated ISO codes (e.g. "de, en"). After a change, clear the data caches and run a full sync (`update-items --forceAll`).',
        id: 'vocabularyLanguages',
        name: 'vocabularyLanguages',
        value: settings['vocabularyLanguages'] is iterable ? settings['vocabularyLanguages']|join(', ') : settings['vocabularyLanguages'],
        errors: settings.getErrors('vocabularyLanguages')})
    }}

    {{ forms.textField({
        label: 'Vocabulary Fallback Language',
        instructions: 'Language of the main vocabulary title, also used for sites without a term in their language (e.g. "de"). Vocabulary entries are identified by the term ID in this language: don\'t change it after the first import, or all entries are created again.',
        id: 'vocabularyFallbackLanguage',
        name: 'vocabularyFallbackLanguage',
        value: settings['vocabularyFallbackLanguage'],
        errors: settings.getErrors('vocabularyFallbackLanguage')})
    }}

    {{ forms.textField({
        label: 'Google Gemini API Key (Gemini 1.0 Pro with billing account linked)',
        instructions: 'The api key can be created <a href="https://aistudio.google.com/app/apikey" target="_blank">here</a>',
        id: 'googleGeminiApiKey',
        name: 'googleGeminiApiKey',
        value: settings['googleGeminiApiKey']})
    }}

{% endblock %}